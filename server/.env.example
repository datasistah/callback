# Supabase project URL (Settings → API → Project URL)
SUPABASE_URL=

# Supabase publishable (anon) key — safe to expose client-side
SUPABASE_PUBLISHABLE_KEY=

# Supabase secret (service role) key — SERVER ONLY, never ship to client
SUPABASE_SECRET_KEY=

# Postgres connection string (Settings → Database → Connection string → URI, Session mode, port 5432)
# Used by migrate.js to create tables. Looks like:
# postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=

# ---------------------------------------------------------------------------
# LLM providers (Agent Harness). Set at least one to enable AI features. With
# none set, the app falls back to deterministic mocks so the core loop still
# works. See docs/llm-setup.md for a walkthrough.
# ---------------------------------------------------------------------------

# OpenRouter (recommended for quality). Get a key: https://openrouter.ai/keys
# Pick any model; a `:free` model costs nothing to start. Browse models at
# https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Local Ollama (optional, for cheap/offline/private drafting).
# Install: https://ollama.com — then `ollama pull qwen2.5:3b`
OLLAMA_ENABLED=0
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434

# Career Vault embeddings (Phase 1). Ollama embedding model used for pgvector
# retrieval + the groundedness check. MUST be 768-dimensional to match the
# career_items.embedding column (nomic-embed-text is). With no Ollama reachable,
# the app falls back to a deterministic local embedder so the vault still works.
#   ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text

# Anthropic (optional) — Claude via the official SDK.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Default provider when a task has no specific route (openrouter | ollama | anthropic).
# Per-task overrides: CALLBACK_PROVIDER_RESUME_TAILOR, CALLBACK_PROVIDER_STAR_CRITIQUE, etc.
CALLBACK_LLM_PROVIDER=openrouter

# Groundedness threshold (Phase 1): min cosine similarity between a tailored
# bullet and the Career Vault item it cites for the bullet to count as
# "grounded". Below this, the bullet is flagged unverified. Default 0.3.
GROUNDEDNESS_THRESHOLD=0.3
